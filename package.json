{
  "name": "hq-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "OmniHQ - Phase 1: multi-business database architecture and data isolation",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "db:create": "cross-env PROCESS_ROLE=migration tsx scripts/create-database.ts",
    "db:bootstrap": "cross-env PROCESS_ROLE=migration tsx scripts/bootstrap-database.ts",
    "db:migrate": "cross-env PROCESS_ROLE=migration tsx scripts/migrate.ts up",
    "db:rollback": "cross-env PROCESS_ROLE=migration tsx scripts/migrate.ts down",
    "db:status": "cross-env PROCESS_ROLE=migration tsx scripts/migrate.ts status",
    "db:grants": "cross-env PROCESS_ROLE=migration tsx scripts/apply-grants.ts",
    "db:seed:demo": "cross-env PROCESS_ROLE=migration tsx scripts/seed-demo-marketplace.ts",
    "db:promote-admin": "cross-env PROCESS_ROLE=migration tsx scripts/admin-role.ts promote",
    "db:revoke-admin": "cross-env PROCESS_ROLE=migration tsx scripts/admin-role.ts revoke",
    "db:setup": "npm run db:create && npm run db:bootstrap && npm run db:migrate && npm run db:grants && npm run db:seed",
    "db:seed": "cross-env PROCESS_ROLE=migration tsx scripts/seed.ts",
    "preflight": "cross-env PROCESS_ROLE=preflight tsx scripts/preflight.ts",
    "compose:validate": "node scripts/validate-compose-config.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:email-worker": "node dist/email-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "cross-env DOTENV_CONFIG_PATH=.env.test PGDATABASE=hq_marketplace_test node --import ./tests/helpers/register-typescript-loader.mjs scripts/apply-grants.ts",
    "test": "cross-env DOTENV_CONFIG_PATH=.env.test PGDATABASE=hq_marketplace_test node --import ./tests/helpers/register-typescript-loader.mjs --import ./tests/helpers/no-network-email.ts --test --test-concurrency=1 tests/**/*.test.ts",
    "test:file": "cross-env DOTENV_CONFIG_PATH=.env.test PGDATABASE=hq_marketplace_test node --import ./tests/helpers/register-typescript-loader.mjs --import ./tests/helpers/no-network-email.ts --test --test-concurrency=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
