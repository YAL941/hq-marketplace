# ---- migration / admin connection (schema owner, bypasses RLS) ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=hq_marketplace
PGUSER=postgres
# This is the highest-privilege credential in the project: the schema owner can
# read and write every table regardless of row level security. In production the
# server refuses to start if it is unset, under 16 characters, or a placeholder
# such as "change-me" — the same rule JWT_SECRET and APP_DB_PASSWORD follow.
PGPASSWORD=change-me

# ---- application connection (RLS enforced) ----
# Must NOT be the same value as PGUSER. Running the API as the table owner turns
# every row level security policy off, and nothing about that fails visibly:
# requests still return 200 and still return other businesses' rows. Production
# refuses to start when these two match, and `src/db/pool.ts` asks the database
# for the real answer at boot regardless of what is written here.
APP_DB_USER=hq_app
APP_DB_PASSWORD=change-me

# ---- app ----
PORT=4000
# Internal, unpaid orders default to enabled in every environment.
# Set ORDERS_ENABLED=false to pause customer order intake.
# At least 32 random characters when NODE_ENV=production; the server refuses to
# start if this is missing, too short, or a known placeholder such as
# "change-me". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# ---- optional email notifications for admin business decisions ----
# SMTP_PORT=465 typically requires SMTP_SECURE=true; port 587 usually uses false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OmniHQ <no-reply@example.com>
# Public web origin used in password reset links.
PUBLIC_APP_URL=http://localhost:3001

# Comma separated allow list of browser origins. A wildcard is NOT accepted.
# In production an empty list, "*", or any http:// origin aborts the boot.
# Local development falls back to the Vite dev server below.
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the API, i.e. what express's `trust proxy` is
# set to. Must cover exactly the proxies that sit in front of the API: too low and
# every visitor shares one rate-limit counter, too high and a caller can forge
# X-Forwarded-For and walk around the limiters.
#
# There is deliberately no production default. Both of the plausible mistakes
# are silent, so NODE_ENV=production refuses to start until this is set
# explicitly. Count the proxies between the internet and this process:
#   direct to the port           0
#   one Caddy/nginx              1
#   Cloudflare + Caddy/nginx     2
# Development and test default to 0.
TRUST_PROXY_HOPS=0

# ---- image uploads ----
# Which StorageProvider stores uploaded images. `local` is the only driver that
# exists today and is the default, so a fresh clone serves uploads without
# touching this file. S3 / Cloudflare R2 will arrive as new values here.
STORAGE_DRIVER=local
# Root folder for stored images. A relative path is resolved against the
# process working directory (the project root for `npm run dev` and `npm start`).
# Production refuses to start on a relative value, because the working directory
# of systemd or a container is not the project root: the first upload would then
# be written somewhere outside the mounted volume, and every image already stored
# under the previous path becomes unreachable with no error. Mount this as its own
# volume and point it at an absolute path.
# This folder is an implementation detail: the URL stored in the database is
# always /uploads/<businessId>/<slot>/<name>, so moving or remounting the folder
# does not invalidate a single stored row.
UPLOAD_DIR=uploads
# Per-image ceilings in bytes. The API enforces these while the request is still
# streaming, so an oversize upload is refused without being buffered whole.
UPLOAD_MAX_LOGO_BYTES=2097152
UPLOAD_MAX_COVER_BYTES=5242880
UPLOAD_MAX_PRODUCT_BYTES=5242880
# Decompression-bomb guard: a small file can declare a huge number of pixels.
UPLOAD_MAX_PIXELS=40000000

# ---- tests ----
TEST_DATABASE_URL=postgres://hq_app:change-me@localhost:5432/hq_marketplace_test
