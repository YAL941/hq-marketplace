# ---- migration / admin connection (schema owner, bypasses RLS) ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=hq_marketplace
PGUSER=postgres
PGPASSWORD=change-me

# ---- application connection (RLS enforced) ----
APP_DB_USER=hq_app
APP_DB_PASSWORD=change-me

# ---- app ----
PORT=4000
# At least 32 random characters when NODE_ENV=production; the server refuses to
# start if this is missing, too short, or a known placeholder such as
# "change-me". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Comma separated allow list of browser origins. A wildcard is NOT accepted.
# In production an empty list, "*", or any http:// origin aborts the boot.
# Local development falls back to the Vite dev server below.
CORS_ORIGIN=http://localhost:5173

# ---- image uploads ----
# Which StorageProvider stores uploaded images. `local` is the only driver that
# exists today and is the default, so a fresh clone serves uploads without
# touching this file. S3 / Cloudflare R2 will arrive as new values here.
STORAGE_DRIVER=local
# Root folder for stored images. A relative path is resolved against the
# process working directory (the project root for `npm run dev` and `npm start`).
# This folder is an implementation detail: the URL stored in the database is
# always /uploads/<businessId>/<slot>/<name>, so moving or remounting the folder
# does not invalidate a single stored row.
UPLOAD_DIR=uploads
# Per-image ceilings in bytes. The API enforces these while the request is still
# streaming, so an oversize upload is refused without being buffered whole.
UPLOAD_MAX_LOGO_BYTES=2097152
UPLOAD_MAX_COVER_BYTES=5242880
UPLOAD_MAX_PRODUCT_BYTES=5242880
# Decompression-bomb guard: a small file can declare a huge number of pixels.
UPLOAD_MAX_PIXELS=40000000

# ---- tests ----
TEST_DATABASE_URL=postgres://hq_app:change-me@localhost:5432/hq_marketplace_test
