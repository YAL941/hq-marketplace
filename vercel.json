{
  "framework": null,
  "installCommand": "npm ci --include=dev && npm --prefix frontend ci --include=dev",
  "buildCommand": "npm run build && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__api_path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
